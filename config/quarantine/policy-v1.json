{
  "schema": "azazel-boot/quarantine-policy@1",
  "version": "quarantine.v1",
  "comment": "The host-storage quarantine, as a versioned artifact. A build pins this by its version; the payload carries that version in its artifact record. Nothing here has ever run.",
  "early_hooks": [
    "az-quarantine-block-devices",
    "az-disable-resume",
    "az-disable-automount",
    "az-disable-volume-assembly",
    "az-mark-boot-medium"
  ],
  "actions": [
    "read",
    "automount",
    "writable_mount",
    "swap_activation",
    "resume_from_hibernation",
    "fsck",
    "journal_replay",
    "lvm_assembly",
    "md_assembly",
    "zfs_import",
    "indexing",
    "firmware_update",
    "export_write"
  ],
  "blocked_on_a_quarantined_device": "every action above, including read",
  "never_allowed_anywhere": [
    "firmware_update",
    "resume_from_hibernation"
  ],
  "unblockable_by_approval": [
    "export_write"
  ],
  "excluded_from_the_zero_write_claim": [
    "firmware_nvram_boot_entry",
    "firmware_nvram_boot_order"
  ],
  "initramfs_requirements": {
    "quarantine_hook_runs_first": true,
    "quarantine_persists_into_userspace": true,
    "resume_enabled": false,
    "automount_rules": []
  }
}
