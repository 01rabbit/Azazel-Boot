[Unit]
Description=Azazel C5 QEMU fixture persistence probe
ConditionKernelCommandLine=azazel.c5_fixture=QEMU-regular-file
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/azazel-c5-persistence-probe
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
