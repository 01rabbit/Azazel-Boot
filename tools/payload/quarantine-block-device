#!/bin/sh
set -eu

invocation=${1:-}
origin=${2:-NOT_OBSERVED}
mode=${3:-quarantine}
event_seqnum=${SEQNUM:-NOT_OBSERVED}
if [ "$origin" = probe ]; then
  case "$invocation" in
    vdbseq[0-9]*)
      name=vdb
      event_seqnum=${invocation#vdbseq}
      case "$event_seqnum" in ''|*[!0-9]*) echo 'refusing invalid udev event sequence' >&2; exit 2 ;; esac
      ;;
    *) echo 'refusing probe invocation without a vdb udev event sequence' >&2; exit 2 ;;
  esac
else
  name=$invocation
fi
case "$name" in
  ''|*[!A-Za-z0-9_.-]*) echo 'refusing invalid block-device kernel name' >&2; exit 2 ;;
esac
case "$origin" in initramfs|udev|probe) ;; *) echo 'refusing unknown quarantine invocation' >&2; exit 2 ;; esac
case "$mode" in quarantine|probe) ;; *) echo 'refusing unknown quarantine mode' >&2; exit 2 ;; esac
case "$origin:$mode" in
  initramfs:quarantine|udev:quarantine|probe:probe) ;;
  *)
  echo 'quarantine/probe origin and mode do not match' >&2
  exit 2
  ;;
esac

device=/dev/$name
sys_device=/sys/class/block/$name
fixture_record=/run/azazel/c5-hotplug-evidence.jsonl
mkdir -p /run/azazel || { echo 'cannot create quarantine evidence directory' >&2; exit 1; }
invocation_dir=$(mktemp -d /run/azazel/c5-helper.XXXXXX) || {
  echo 'cannot allocate private quarantine evidence directory' >&2
  exit 1
}
trace=$invocation_dir/write.strace
enforce_trace=$invocation_dir/enforce.strace
enforce_stderr=$invocation_dir/enforce.stderr
enforce_stdout=$invocation_dir/enforce.stdout
target_trace=$invocation_dir/target.strace
probe_trace=$invocation_dir/probe.strace
dd_stderr=$invocation_dir/dd.stderr
kernel_before=$invocation_dir/kernel-before.log
kernel_relevant=$invocation_dir/kernel-relevant.log
diagnostic_read=$invocation_dir/diagnostic-read.tmp
diagnostic_chunk=$invocation_dir/diagnostic-chunk.tmp
diagnostic_limit=4096
is_hotplug_fixture=0
is_initramfs_fixture=0
devpath=${DEVPATH:-NOT_OBSERVED}
action=${ACTION:-NOT_OBSERVED}
subsystem=${SUBSYSTEM:-NOT_OBSERVED}
udev_provenance_status=NOT_OBSERVED
device_devno=$(cat "$sys_device/dev" 2>/dev/null || printf NOT_OBSERVED)

validate_handoff_generation() {
  expected_generation=$1
  recorded_generation=$2
  case "$expected_generation" in ''|*[!0-9]*) return 1 ;; esac
  [ "$recorded_generation" = "$expected_generation" ]
}

[ -b "$device" ] || { echo "block node is absent for $name" >&2; exit 1; }
[ -r "$sys_device/ro" ] && [ -r "$sys_device/dev" ] || {
  echo "sysfs state is absent for $name" >&2
  exit 1
}
if { [ "$origin" = udev ] || [ "$origin" = probe ]; } && \
   [ -e /run/azazel/c5-hotplug-fixture-enabled ] && [ "$name" = vdb ]; then
  if grep -Eq '(^| )azazel\.c5_fixture=QEMU-regular-file( |$)' /proc/cmdline 2>/dev/null; then
    is_hotplug_fixture=1
  fi
fi
if [ "$origin" = initramfs ] && [ "$name" = vda ] && \
   grep -Eq '(^| )azazel\.c5_fixture=QEMU-regular-file( |$)' /proc/cmdline 2>/dev/null; then
  is_initramfs_fixture=1
fi

read_bounded_attr() {
  dd if="$1" bs=129 count=1 2>/dev/null
}

fixture_disk_serial() {
  serial_link=$1
  devices_root=$2
  resolved_root=$(readlink -f "$devices_root" 2>/dev/null) || return 1
  resolved_serial=$(readlink -f "$serial_link" 2>/dev/null) || return 1
  case "$resolved_serial" in
    "$resolved_root"/*/serial)
      [ -f "$resolved_serial" ] || return 1
      read_bounded_attr "$resolved_serial"
      ;;
    *) return 1 ;;
  esac
}

fixture_disk_serial_hex() {
  serial_link=$1
  devices_root=$2
  resolved_root=$(readlink -f "$devices_root" 2>/dev/null) || return 1
  resolved_serial=$(readlink -f "$serial_link" 2>/dev/null) || return 1
  case "$resolved_serial" in
    "$resolved_root"/*/serial)
      [ -f "$resolved_serial" ] || return 1
      od -An -v -tx1 -N129 "$resolved_serial" 2>/dev/null | tr -d ' \n'
      ;;
    *) return 1 ;;
  esac
}

uptime() { cut -d' ' -f1 /proc/uptime 2>/dev/null || printf NOT_OBSERVED; }
sysfs_ro() { cat "$sys_device/ro" 2>/dev/null || printf NOT_OBSERVED; }
blockdev_ro() { /usr/sbin/blockdev --getro "$device" 2>/dev/null || printf NOT_OBSERVED; }
mount_state() {
  devno=$(cat "$sys_device/dev" 2>/dev/null || true)
  [ -n "$devno" ] || { printf NOT_OBSERVED; return; }
  if awk -v wanted="$devno" '$3 == wanted { found=1 } END { exit found ? 0 : 1 }' /proc/self/mountinfo; then
    printf mounted
  else
    printf not_mounted
  fi
}
mount_details() {
  devno=$(cat "$sys_device/dev" 2>/dev/null || true)
  mount_info=$(awk -v wanted="$devno" '
    $3 == wanted {
      separator=0
      for (i=7; i<=NF; i++) if ($i == "-") { separator=i; break }
      if (separator) { printf "%s\t%s\t%s\t%s", $5, $6, $(separator+1), $(separator+2); found=1; exit }
    }
    END { if (!found) exit 1 }
  ' /proc/self/mountinfo 2>/dev/null) || mount_info=
  if [ -n "$mount_info" ]; then
    mount_status=mounted
    mount_tab=$(printf '\t')
    mount_point=${mount_info%%"$mount_tab"*}
    mount_rest=${mount_info#*"$mount_tab"}
    mount_flags=${mount_rest%%"$mount_tab"*}
    mount_rest=${mount_rest#*"$mount_tab"}
    mount_type=${mount_rest%%"$mount_tab"*}
    mount_source=${mount_rest#*"$mount_tab"}
  else
    mount_status=not_mounted
    mount_point=N/A
    mount_flags=N/A
    mount_type=N/A
    mount_source=N/A
  fi
}
emit_event() {
  event_phase=$1
  event_status=$2
  event_fields=${3:-}
  event_uptime=$(uptime)
  event_stage=hotplug
  [ "$origin" = initramfs ] && event_stage=initramfs
  event_origin=$origin
  [ "$origin" = probe ] && event_origin=udev
  event="AZAZEL_C5_PHASE phase=$event_phase status=$event_status stage=$event_stage target=$device path=$device origin=$event_origin devpath=$devpath action=$action subsystem=$subsystem kernel_name=$name sysfs_devno=$device_devno udev_seqnum=$event_seqnum udev_provenance=$udev_provenance_status guest_uptime_seconds=$event_uptime $event_fields"
  printf '%s\n' "$event" >/dev/console 2>/dev/null || true
  if [ "$is_hotplug_fixture" = 1 ]; then
    event_json=$(printf '%s' "$event" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"phase":"%s","status":"%s","guest_uptime_seconds":"%s","target":"%s","path":"%s","origin":"%s","devpath":"%s","action":"%s","subsystem":"%s","udev_seqnum":"%s","record":"%s"}\n' \
      "$event_phase" "$event_status" "$event_uptime" "$device" "$device" "$event_origin" \
      "$devpath" "$action" "$subsystem" "$event_seqnum" "$event_json" >> "$fixture_record"
  fi
}
emit_trace() {
  trace_raw=$1
  trace_call=${trace_raw%%(*}
  trace_return=${trace_raw##* = }
  trace_value=${trace_return%% *}
  trace_errno=NOT_OBSERVED
  if [ "$trace_value" = -1 ]; then
    trace_errno=$(printf '%s\n' "$trace_return" | awk '{print $2}')
    [ -n "$trace_errno" ] || trace_errno=NOT_OBSERVED
  fi
  printf 'AZAZEL_C5_WRITE_SYSCALL stage=hotplug target=%s %s\n' \
    "$device" "$trace_raw" >/dev/console 2>/dev/null || true
  if [ "$is_hotplug_fixture" = 1 ]; then
    trace_json=$(printf '%s' "$trace_raw" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"phase":"target_write","syscall":"%s","result":"%s","errno":"%s","raw":"%s","guest_uptime_seconds":"%s","udev_seqnum":"%s"}\n' \
      "$trace_call" "$trace_value" "$trace_errno" "$trace_json" "$(uptime)" "$event_seqnum" >> "$fixture_record"
  fi
}

if [ "$origin" = udev ]; then
  udev_provenance_status=PASS
  case "$devpath" in
    /devices/*) ;;
    *) udev_provenance_status=FAIL ;;
  esac
  case "$devpath" in *'/../'*|*/..|*'//'*|*' '*|*'='*) udev_provenance_status=FAIL ;; esac
  [ "$action" = add ] && [ "$subsystem" = block ] || udev_provenance_status=FAIL
  [ "${devpath##*/}" = "$name" ] || udev_provenance_status=FAIL
  expected_sysfs=$(readlink -f "$sys_device" 2>/dev/null || true)
  event_sysfs=$(readlink -f "/sys$devpath" 2>/dev/null || true)
  [ -n "$expected_sysfs" ] && [ "$event_sysfs" = "$expected_sysfs" ] || udev_provenance_status=FAIL
  udev_device_serial=NOT_OBSERVED
  if [ "$is_hotplug_fixture" = 1 ]; then
    udev_device_serial=$(fixture_disk_serial "$sys_device/serial" /sys/devices 2>/dev/null || printf NOT_OBSERVED)
    [ "$udev_device_serial" = AZC5-VDB-FILE-01 ] || udev_provenance_status=FAIL
    case "$event_seqnum" in ''|*[!0-9]*|NOT_OBSERVED) udev_provenance_status=FAIL ;; esac
  fi
  if [ "$is_hotplug_fixture" = 1 ]; then
    emit_event udev_rule "$udev_provenance_status" \
      "mechanism=udev-rule-invoked-helper helper=$0 device_serial=$udev_device_serial"
  fi
  if [ "$udev_provenance_status" != PASS ]; then
    echo "refusing udev invocation without validated add/block DEVPATH provenance for $device" >&2
    exit 1
  fi
  if [ "$is_hotplug_fixture" = 1 ]; then
    # A SEQNUM names one udev event; clear only that event's paths before RO enforcement.
    handoff="/run/azazel/c5-hotplug-vdb-$event_seqnum.ready"
    rm -f "$handoff" "$handoff.tmp"
  fi
fi
classify_probe_result() {
  probe_result=$1
  probe_status=FAIL
  probe_classification=write_syscall_or_errno_not_observed
  probe_causality=UNPROVEN
  write_call=$(printf '%s\n' "$probe_result" | sed -n 's/^syscall=\([^ ]*\).*/\1/p')
  write_result=$(printf '%s\n' "$probe_result" | sed -n 's/.* result=\([^ ]*\).*/\1/p')
  write_errno_number=$(printf '%s\n' "$probe_result" | sed -n 's/.* errno=\([^ ]*\).*/\1/p')
  write_errno=$(printf '%s\n' "$probe_result" | sed -n 's/.*errno_name=//p')
  [ -n "$write_errno" ] || write_errno=NOT_OBSERVED
  case "$write_errno_number" in ''|*[!0-9]*) write_errno_number=NOT_OBSERVED ;; esac
  if [ "$write_call" = write ] && [ "$write_result" = -1 ] && \
     [ "$write_errno_number" != NOT_OBSERVED ] && [ "$write_errno_number" -gt 0 ] && \
     [ "$write_errno" != NOT_OBSERVED ] && [ "$write_errno" != NONE ]; then
    case "$write_errno" in
      EROFS|EPERM)
        probe_status=PASS
        probe_classification=read_only_policy_denial_observed
        ;;
      *)
        probe_status=FAIL
        probe_classification=write_failed_causality_unproven
        ;;
    esac
  elif [ "$write_call" = open ] && [ "$write_result" = -1 ] && \
       [ "$write_errno_number" != NOT_OBSERVED ] && [ "$write_errno_number" -gt 0 ] && \
       [ "$write_errno" != NOT_OBSERVED ] && [ "$write_errno" != NONE ]; then
    case "$write_errno" in
      EROFS)
        probe_status=PASS
        probe_classification=open_denied_by_read_only_policy
        ;;
      *)
        probe_status=FAIL
        probe_classification=open_failed_causality_unproven
        ;;
    esac
  elif [ "$write_call" = write ]; then
    probe_classification=write_result_not_read_only_denial
  fi
}
run_hotplug_write_probe() {
  write_errno=NOT_OBSERVED
  handoff="/run/azazel/c5-hotplug-vdb-$event_seqnum.ready"
  handoff_attempt=0
  while [ ! -f "$handoff" ] && [ "$handoff_attempt" -lt 30 ]; do
    sleep 0.1
    handoff_attempt=$((handoff_attempt + 1))
  done
  handoff_devno=NOT_OBSERVED
  handoff_devpath=NOT_OBSERVED
  handoff_action=NOT_OBSERVED
  handoff_subsystem=NOT_OBSERVED
  handoff_serial=NOT_OBSERVED
  handoff_seqnum=NOT_OBSERVED
  if [ -f "$handoff" ] && [ "$(stat -c '%u:%a' "$handoff" 2>/dev/null || true)" = 0:600 ]; then
    IFS='|' read -r handoff_seqnum handoff_devno handoff_devpath handoff_action handoff_subsystem handoff_serial < "$handoff" || :
    rm -f "$handoff"
  fi
  devpath=$handoff_devpath
  action=$handoff_action
  subsystem=$handoff_subsystem
  udev_provenance_status=PASS
  current_sysfs=$(readlink -f "$sys_device" 2>/dev/null || true)
  event_sysfs=$(readlink -f "/sys$devpath" 2>/dev/null || true)
  case "$devpath" in /devices/*) ;; *) udev_provenance_status=FAIL ;; esac
  case "$devpath" in *'/../'*|*/..|*'//'*|*' '*|*'='*) udev_provenance_status=FAIL ;; esac
  [ "$action" = add ] && [ "$subsystem" = block ] || udev_provenance_status=FAIL
  [ "${devpath##*/}" = vdb ] && [ "$event_sysfs" = "$current_sysfs" ] || udev_provenance_status=FAIL
  validate_handoff_generation "$event_seqnum" "$handoff_seqnum" && [ "$handoff_devno" = "$device_devno" ] && \
    [ "$handoff_serial" = AZC5-VDB-FILE-01 ] || udev_provenance_status=FAIL
  serial=$(fixture_disk_serial "$sys_device/serial" /sys/devices 2>/dev/null || printf NOT_OBSERVED)
  dmi_vendor=$(read_bounded_attr /sys/class/dmi/id/sys_vendor 2>/dev/null || printf NOT_OBSERVED)
  dmi_product=$(read_bounded_attr /sys/class/dmi/id/product_name 2>/dev/null || printf NOT_OBSERVED)
  cmdline_status=FAIL
  if grep -Eq '(^| )azazel\.c5_fixture=QEMU-regular-file( |$)' /proc/cmdline 2>/dev/null; then
    cmdline_status=PASS
  fi
  fixture_status=FAIL
  if [ "$is_hotplug_fixture" = 1 ] && [ "$udev_provenance_status" = PASS ] && \
     [ "$serial" = AZC5-VDB-FILE-01 ] && [ "$dmi_vendor" = QEMU ] && \
     [ "$dmi_product" = 'Azazel C5 File Fixture' ] && [ "$cmdline_status" = PASS ]; then
    fixture_status=PASS
  fi
  before_sysfs=$(sysfs_ro)
  before_blockdev=$(blockdev_ro)
  before_mount=$(mount_state)
  if [ "$fixture_status" != PASS ] || [ "$before_sysfs" != 1 ] || \
     [ "$before_blockdev" != 1 ] || [ "$before_mount" != not_mounted ]; then
    emit_event target_write NOT_OBSERVED \
      "classification=write_probe_guard_failed fixture_status=$fixture_status cmdline_status=$cmdline_status handoff_seqnum=$handoff_seqnum handoff_devno=$handoff_devno udev_seqnum=$event_seqnum sysfs_ro_before=$before_sysfs blockdev_ro_before=$before_blockdev mount_state=$before_mount"
    printf 'AZAZEL_C5_WRITE_PROBE_RESULT stage=hotplug target=/dev/vdb udev_seqnum=%s status=FAIL classification=write_probe_guard_failed syscall=NOT_OBSERVED result=NOT_OBSERVED errno=NOT_OBSERVED errno_name=NOT_OBSERVED\n' "$event_seqnum" >/dev/console 2>/dev/null || true
    printf '{"phase":"write_probe","stage":"hotplug","target":"/dev/vdb","status":"FAIL","classification":"write_probe_guard_failed","syscall":"NOT_OBSERVED","result":"NOT_OBSERVED","errno":"NOT_OBSERVED","errno_name":"NOT_OBSERVED","guest_uptime_seconds":"%s","udev_seqnum":"%s"}\n' "$(uptime)" "$event_seqnum" >> "$fixture_record"
    return 1
  fi

  emit_event target_write_started PASS \
    "executor=systemd-unit udev_seqnum=$event_seqnum handoff_devno=$handoff_devno fixture_status=PASS fixture_disk_serial=$serial dmi_manufacturer=$dmi_vendor dmi_product_hex=417a617a656c2043352046696c652046697874757265 fixture_cmdline=$cmdline_status fixture_marker=yes mount_state=$before_mount sysfs_ro_before=$before_sysfs blockdev_ro_before=$before_blockdev mechanism_supported=PASS"
  probe_trace=$invocation_dir/probe.strace
  : > "$probe_trace"
  if probe_result=$(timeout 5s /usr/bin/strace -qq -yy -e trace=openat,open,write \
    -o "$probe_trace" python3 -c '
import errno, os, sys
device, generation, expected_devno, expected_sysfs, sysfs_device = sys.argv[1:]

def identity():
    with open(os.path.join(sysfs_device, "dev"), encoding="ascii") as source:
        devno = source.read().strip()
    return devno, os.path.realpath(sysfs_device)

def fail_identity(observed_devno, status):
    print("syscall=probe result=-1 errno=0 expected_devno={} observed_devno={} identity={} udev_seqnum={} errno_name=NOT_OBSERVED".format(
        expected_devno, observed_devno, status, generation))
    sys.stdout.flush()
    raise SystemExit(1)

try:
    try:
        observed_devno, observed_sysfs = identity()
    except OSError:
        fail_identity("NOT_OBSERVED", "FAIL_BEFORE_OPEN")
    if observed_devno != expected_devno or observed_sysfs != expected_sysfs:
        fail_identity(observed_devno, "FAIL_BEFORE_OPEN")
    fd = os.open(device, os.O_WRONLY | os.O_NONBLOCK)
except OSError as exc:
    call, result, number = "open", -1, exc.errno or 0
else:
    try:
        try:
            stat_result = os.fstat(fd)
        except OSError:
            fail_identity("NOT_OBSERVED", "FAIL_AFTER_OPEN")
        fd_devno = "{}:{}".format(os.major(stat_result.st_rdev), os.minor(stat_result.st_rdev))
        try:
            observed_devno, observed_sysfs = identity()
        except OSError:
            fail_identity("NOT_OBSERVED", "FAIL_AFTER_OPEN")
        try:
            with open(os.path.join(sysfs_device, "ro"), encoding="ascii") as source:
                observed_ro = source.read().strip()
        except OSError:
            fail_identity(observed_devno, "FAIL_AFTER_OPEN")
        if fd_devno != expected_devno or observed_devno != expected_devno or \
                observed_sysfs != expected_sysfs or observed_ro != "1":
            fail_identity(observed_devno, "FAIL_AFTER_OPEN")
        result = os.write(fd, bytes([0]))
        call, number = "write", 0
    except OSError as exc:
        call, result, number = "write", -1, exc.errno or 0
    finally:
        os.close(fd)
print("syscall={} result={} errno={} expected_devno={} observed_devno={} identity=PASS udev_seqnum={} errno_name={}".format(
    call, result, number, expected_devno, observed_devno, generation,
    errno.errorcode.get(number, "NONE")))
' /dev/vdb "$event_seqnum" "$handoff_devno" "$current_sysfs" "$sys_device"); then
    probe_exit=0
  else
    probe_exit=$?
    [ -n "$probe_result" ] || probe_result="syscall=probe result=-1 errno=0 expected_devno=$handoff_devno observed_devno=NOT_OBSERVED identity=NOT_OBSERVED udev_seqnum=$event_seqnum errno_name=NOT_OBSERVED"
  fi
  target_trace=$invocation_dir/target.strace
  awk '
    /^(open|openat)\(/ && index($0, "\"/dev/vdb\"") { print; next }
    /^write\(/ && (index($0, "</dev/vdb>") || index($0, "</dev/vdb<block ")) { print }
  ' "$probe_trace" > "$target_trace"
  raw_probe_count=0
  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    [ -n "$raw_line" ] || continue
    raw_probe_count=$((raw_probe_count + 1))
    printf 'AZAZEL_C5_WRITE_SYSCALL stage=hotplug target=/dev/vdb %s\n' "$raw_line" >/dev/console 2>/dev/null || true
  done < "$target_trace"
  classify_probe_result "$probe_result"
  if printf '%s\n' "$probe_result" | grep -Eq 'identity=FAIL_(BEFORE|AFTER)_OPEN'; then
    probe_status=FAIL
    probe_classification=target_identity_mismatch
    probe_causality=UNPROVEN
  elif [ "$raw_probe_count" -eq 0 ] || [ "$probe_exit" -ne 0 ]; then
    probe_status=FAIL
    probe_classification=target_syscall_trace_missing
    probe_causality=UNPROVEN
  fi
  after_sysfs=$(sysfs_ro)
  after_blockdev=$(blockdev_ro)
  after_mount=$(mount_state)
  if [ "$probe_status" = PASS ] && [ "$after_sysfs" = 1 ] && \
     [ "$after_blockdev" = 1 ] && [ "$after_mount" = not_mounted ]; then
    probe_causality=SUPPORTED_BY_MEASURED_READ_ONLY_TRANSITION
  elif [ "$probe_status" = PASS ]; then
    probe_status=FAIL
    probe_classification=denial_prerequisites_not_established
    probe_causality=UNPROVEN
  fi
  write_call=$(printf '%s\n' "$probe_result" | sed -n 's/^syscall=\([^ ]*\).*/\1/p')
  write_result=$(printf '%s\n' "$probe_result" | sed -n 's/.* result=\([^ ]*\).*/\1/p')
  write_errno_number=$(printf '%s\n' "$probe_result" | sed -n 's/.* errno=\([^ ]*\).*/\1/p')
  write_errno=$(printf '%s\n' "$probe_result" | sed -n 's/.*errno_name=\([^ ]*\).*/\1/p')
  probe_expected_devno=$(printf '%s\n' "$probe_result" | sed -n 's/.* expected_devno=\([^ ]*\).*/\1/p')
  probe_observed_devno=$(printf '%s\n' "$probe_result" | sed -n 's/.* observed_devno=\([^ ]*\).*/\1/p')
  probe_identity=$(printf '%s\n' "$probe_result" | sed -n 's/.* identity=\([^ ]*\).*/\1/p')
  [ -n "$write_errno" ] || write_errno=NOT_OBSERVED
  [ -n "$probe_expected_devno" ] || probe_expected_devno=NOT_OBSERVED
  [ -n "$probe_observed_devno" ] || probe_observed_devno=NOT_OBSERVED
  [ -n "$probe_identity" ] || probe_identity=NOT_OBSERVED
  printf 'AZAZEL_C5_WRITE_PROBE stage=hotplug target=/dev/vdb udev_seqnum=%s %s\n' "$event_seqnum" "$probe_result" >/dev/console 2>/dev/null || true
  printf 'AZAZEL_C5_WRITE_PROBE_RESULT stage=hotplug target=/dev/vdb udev_seqnum=%s expected_devno=%s observed_devno=%s identity=%s status=%s classification=%s syscall=%s result=%s errno=%s errno_name=%s\n' \
    "$event_seqnum" "$probe_expected_devno" "$probe_observed_devno" "$probe_identity" "$probe_status" "$probe_classification" "${write_call:-NOT_OBSERVED}" \
    "${write_result:-NOT_OBSERVED}" "${write_errno_number:-NOT_OBSERVED}" "$write_errno" >/dev/console 2>/dev/null || true
  printf '{"phase":"write_probe","stage":"hotplug","target":"/dev/vdb","status":"%s","classification":"%s","syscall":"%s","result":"%s","errno":"%s","errno_name":"%s","guest_uptime_seconds":"%s","udev_seqnum":"%s","expected_devno":"%s","observed_devno":"%s","identity":"%s"}\n' \
    "$probe_status" "$probe_classification" "${write_call:-NOT_OBSERVED}" \
    "${write_result:-NOT_OBSERVED}" "${write_errno_number:-NOT_OBSERVED}" "$write_errno" "$(uptime)" "$event_seqnum" \
    "$probe_expected_devno" "$probe_observed_devno" "$probe_identity" >> "$fixture_record"
  emit_event target_write "$probe_status" \
    "classification=$probe_classification causality=$probe_causality syscall=${write_call:-NOT_OBSERVED} result=${write_result:-NOT_OBSERVED} errno=$write_errno sysfs_ro_before=$before_sysfs blockdev_ro_before=$before_blockdev sysfs_ro_after=$after_sysfs blockdev_ro_after=$after_blockdev mount_state=$after_mount executor=systemd-unit"
  emit_event post_write "$probe_status" \
    "classification=$probe_classification causality=$probe_causality errno=$write_errno sysfs_ro_after=$after_sysfs blockdev_ro_after=$after_blockdev mount_state=$after_mount executor=systemd-unit"
  [ "$probe_status" = PASS ]
}

if [ "$origin" = probe ]; then
  [ "$name" = vdb ] || { echo 'refusing probe for non-fixture block device' >&2; exit 1; }
  if run_hotplug_write_probe; then probe_exit_status=0; else probe_exit_status=$?; fi
  printf 'AZAZEL_C5_HOTPLUG_QUARANTINED target=/dev/vdb udev_seqnum=%s sysfs_ro=%s blockdev_ro=%s write_errno=%s\n' \
    "$event_seqnum" "$(sysfs_ro)" "$(blockdev_ro)" "$write_errno" >/dev/console 2>/dev/null || true
  exit "$probe_exit_status"
fi

file_evidence() {
  evidence_path=$1
  if [ -f "$evidence_path" ]; then
    evidence_state=present
    evidence_bytes=$(wc -c < "$evidence_path") || return 1
    evidence_bytes=$(printf '%s' "$evidence_bytes" | tr -d '[:space:]')
  else
    evidence_state=missing
    evidence_bytes=0
  fi
  printf '%s|%s' "$evidence_state" "$evidence_bytes"
}
cap_diagnostic_file() {
  cap_path=$1
  cap_remaining=$2
  CAP_ORIGINAL=$(wc -c < "$cap_path") || return 1
  CAP_ORIGINAL=$(printf '%s' "$CAP_ORIGINAL" | tr -d '[:space:]')
  CAP_CAPTURED=$CAP_ORIGINAL
  CAP_TRUNCATED=no
  if [ "$CAP_CAPTURED" -gt "$cap_remaining" ]; then
    CAP_CAPTURED=$cap_remaining
    CAP_TRUNCATED=yes
    if [ "$CAP_CAPTURED" -eq 0 ]; then
      : > "$cap_path" || return 1
      return 0
    fi
    if ! head -c "$CAP_CAPTURED" "$cap_path" > "$diagnostic_read"; then
      return 1
    fi
    if ! mv "$diagnostic_read" "$cap_path"; then
      return 1
    fi
  fi
}
cap_diagnostic_streams() {
  CAPTURE_FAILURE=no
  CAPTURE_TOTAL_BYTES=0
  cap_diagnostic_file "$enforce_trace" "$diagnostic_limit" || CAPTURE_FAILURE=yes
  if [ "$CAPTURE_FAILURE" = no ]; then
    trace_original=$CAP_ORIGINAL trace_captured=$CAP_CAPTURED trace_truncated=$CAP_TRUNCATED
    CAPTURE_TOTAL_BYTES=$((CAPTURE_TOTAL_BYTES + CAP_CAPTURED))
    cap_diagnostic_file "$enforce_stderr" "$((diagnostic_limit - CAPTURE_TOTAL_BYTES))" || CAPTURE_FAILURE=yes
  fi
  if [ "$CAPTURE_FAILURE" = no ]; then
    stderr_original=$CAP_ORIGINAL stderr_captured=$CAP_CAPTURED stderr_truncated=$CAP_TRUNCATED
    CAPTURE_TOTAL_BYTES=$((CAPTURE_TOTAL_BYTES + CAP_CAPTURED))
    cap_diagnostic_file "$enforce_stdout" "$((diagnostic_limit - CAPTURE_TOTAL_BYTES))" || CAPTURE_FAILURE=yes
  fi
  if [ "$CAPTURE_FAILURE" = no ]; then
    stdout_original=$CAP_ORIGINAL stdout_captured=$CAP_CAPTURED stdout_truncated=$CAP_TRUNCATED
    CAPTURE_TOTAL_BYTES=$((CAPTURE_TOTAL_BYTES + CAP_CAPTURED))
  fi
}
emit_file_chunks() {
  chunk_stream=$1
  chunk_path=$2
  chunk_size=2048
  if [ ! -f "$chunk_path" ]; then
    emit_event enforce_raw_manifest MISSING \
      "stream=$chunk_stream path=$chunk_path total_bytes=0 chunk_size=$chunk_size chunk_count=0"
    return
  fi
  chunk_total=$(wc -c < "$chunk_path") || {
    emit_event enforce_raw_manifest READ_FAILED \
      "stream=$chunk_stream path=$chunk_path total_bytes=NOT_OBSERVED chunk_size=$chunk_size chunk_count=NOT_OBSERVED"
    return 1
  }
  chunk_total=$(printf '%s' "$chunk_total" | tr -d '[:space:]')
  chunk_count=$(( (chunk_total + chunk_size - 1) / chunk_size ))
  emit_event enforce_raw_manifest CAPTURED \
    "stream=$chunk_stream path=$chunk_path total_bytes=$chunk_total chunk_size=$chunk_size chunk_count=$chunk_count"
  chunk_index=0
  while [ "$chunk_index" -lt "$chunk_count" ]; do
    if ! dd if="$chunk_path" of="$diagnostic_chunk" bs="$chunk_size" skip="$chunk_index" count=1 2>/dev/null; then
      emit_event enforce_raw_manifest READ_FAILED \
        "stream=$chunk_stream path=$chunk_path chunk_index=$chunk_index total_bytes=$chunk_total"
      return 1
    fi
    if ! od -An -v -tx1 "$diagnostic_chunk" > "$diagnostic_read"; then
      emit_event enforce_raw_manifest READ_FAILED \
        "stream=$chunk_stream path=$chunk_path chunk_index=$chunk_index total_bytes=$chunk_total"
      return 1
    fi
    if ! chunk_hex=$(tr -d '[:space:]' < "$diagnostic_read"); then
      emit_event enforce_raw_manifest READ_FAILED \
        "stream=$chunk_stream path=$chunk_path chunk_index=$chunk_index total_bytes=$chunk_total"
      return 1
    fi
    emit_event enforce_raw_chunk CAPTURED \
      "stream=$chunk_stream chunk_index=$chunk_index chunk_count=$chunk_count raw_hex=$chunk_hex"
    chunk_index=$((chunk_index + 1))
  done
}

if [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; then
  pre_sysfs=$(sysfs_ro)
  pre_blockdev=$(blockdev_ro)
  pre_mount=$(mount_state)
  emit_event helper_started PASS \
    "fixture_cmdline=PASS sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$pre_sysfs blockdev_ro_after=$pre_blockdev mount_state=$pre_mount"
else
  pre_sysfs=$(sysfs_ro)
  pre_blockdev=$(blockdev_ro)
  pre_mount=$(mount_state)
fi
mount_details
  if [ "$is_hotplug_fixture" = 1 ]; then
    emit_event enforce_ioctl_started PASS \
    "sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev mount_state=$pre_mount mount_point=$mount_point mount_type=$mount_type mount_flags=$mount_flags"
fi

enforce_status=NOT_OBSERVED
enforce_command_return=NOT_RUN
strace_available=no
: > "$enforce_stderr"
: > "$enforce_stdout"
: > "$enforce_trace"
enforce_method=strace-blkroset
if [ "$origin" = udev ]; then
  # systemd-udevd's sandbox denies ptrace. Use blockdev directly and rely on
  # independently observed RO state; the fixture additionally requires a
  # measured 0 -> 1 transition in both kernel views.
  enforce_method=blockdev-setro
  if (ulimit -f 8 || exit 125
      /usr/sbin/blockdev --setro "$device") \
      >"$enforce_stdout" 2>"$enforce_stderr"; then
    enforce_status=PASS
    enforce_command_return=0
  else
    enforce_command_return=$?
    enforce_status=FAIL
  fi
elif [ -x /usr/bin/strace ]; then
  strace_available=yes
  if (ulimit -f 8 || exit 125
      exec /usr/bin/strace -qq -yy -e trace=ioctl -o "$enforce_trace" \
        /usr/sbin/blockdev --setro "$device") \
      >"$enforce_stdout" 2>"$enforce_stderr"; then
    enforce_status=PASS
    enforce_command_return=0
  else
    enforce_command_return=$?
    enforce_status=FAIL
  fi
else
  enforce_status=FAIL
fi

if [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; then
  trace_original=0 trace_captured=0 trace_truncated=no
  stderr_original=0 stderr_captured=0 stderr_truncated=no
  stdout_original=0 stdout_captured=0 stdout_truncated=no
  cap_diagnostic_streams
  if trace_evidence=$(file_evidence "$enforce_trace"); then trace_evidence_status=0; else trace_evidence_status=1; fi
  if stderr_evidence=$(file_evidence "$enforce_stderr"); then stderr_evidence_status=0; else stderr_evidence_status=1; fi
  if stdout_evidence=$(file_evidence "$enforce_stdout"); then stdout_evidence_status=0; else stdout_evidence_status=1; fi
  trace_state=${trace_evidence%%|*}
  trace_bytes=${trace_evidence#*|}
  stderr_state=${stderr_evidence%%|*}
  stderr_bytes=${stderr_evidence#*|}
  stdout_state=${stdout_evidence%%|*}
  stdout_bytes=${stdout_evidence#*|}
  diagnostic_stage=hotplug
  [ "$origin" = initramfs ] && diagnostic_stage=initramfs
  capture_status=PASS
  [ "$CAPTURE_FAILURE" = no ] || capture_status=FAIL
  diagnostic="stage=$diagnostic_stage target_device=$device strace_available=$strace_available command_return=$enforce_command_return capture_status=$capture_status capture_total_bytes=$CAPTURE_TOTAL_BYTES capture_limit=$diagnostic_limit trace_path=$enforce_trace trace_state=$trace_state trace_bytes=$trace_bytes trace_original_bytes=$trace_original trace_truncated=$trace_truncated stderr_path=$enforce_stderr stderr_state=$stderr_state stderr_bytes=$stderr_bytes stderr_original_bytes=$stderr_original stderr_truncated=$stderr_truncated stdout_path=$enforce_stdout stdout_state=$stdout_state stdout_bytes=$stdout_bytes stdout_original_bytes=$stdout_original stdout_truncated=$stdout_truncated"
  printf 'AZAZEL_C5_ENFORCE_DIAGNOSTIC %s\n' "$diagnostic" \
    >/dev/console 2>/dev/null || true
  emit_event enforce_diagnostic "$capture_status" "$diagnostic"
  chunks_status=0
  if [ "$CAPTURE_FAILURE" = no ]; then
    emit_file_chunks trace "$enforce_trace" || chunks_status=1
    emit_file_chunks stderr "$enforce_stderr" || chunks_status=1
    emit_file_chunks stdout "$enforce_stdout" || chunks_status=1
  else
    chunks_status=1
  fi
  if [ "$CAPTURE_FAILURE" != no ] || [ "$trace_evidence_status" -ne 0 ] || \
     [ "$stderr_evidence_status" -ne 0 ] || [ "$stdout_evidence_status" -ne 0 ] || \
     [ "$chunks_status" -ne 0 ]; then
    emit_event enforce_diagnostic FAIL \
      "capture_status=READ_FAILED chunks_status=$chunks_status capture_total_bytes=$CAPTURE_TOTAL_BYTES"
    enforce_status=FAIL
  fi
fi

post_sysfs=$(sysfs_ro)
post_blockdev=$(blockdev_ro)
post_mount=$(mount_state)
enforce_ioctl=NOT_OBSERVED
if [ "$origin" = udev ]; then
  if [ "$enforce_command_return" = 0 ] && [ "$post_sysfs" = 1 ] && \
     [ "$post_blockdev" = 1 ] && \
     { [ "$is_hotplug_fixture" != 1 ] || \
       { [ "$pre_sysfs" = 0 ] && [ "$pre_blockdev" = 0 ]; }; }; then
    enforce_ioctl=PASS
  else
    enforce_ioctl=FAIL
  fi
  if [ "$is_hotplug_fixture" = 1 ]; then
    printf 'AZAZEL_C5_ENFORCE_SYSCALL stage=hotplug target=%s command_return=%s status=%s method=blockdev-setro raw_hex=NOT_OBSERVED\n' \
      "$device" "$enforce_command_return" "$enforce_ioctl" >/dev/console 2>/dev/null || true
    emit_event enforce_ioctl "$enforce_ioctl" \
      "syscall=blockdev-setro result=$enforce_command_return errno=NOT_OBSERVED command_return=$enforce_command_return method=blockdev-setro raw_hex=NOT_OBSERVED sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev mount_state=$post_mount mount_type=$mount_type mount_flags=$mount_flags"
  fi
elif [ -s "$enforce_trace" ]; then
  enforce_ioctl_line=$(awk -v target="$device" \
    '/ioctl\(/ && (index($0, "<" target ">") || index($0, "<" target "<block ")) && /BLKROSET/ { print; exit }' \
    "$enforce_trace")
  if [ -n "$enforce_ioctl_line" ]; then
    case "$enforce_ioctl_line" in *'= 0'|*'= 0 (INJECTED)') enforce_ioctl=PASS ;; *) enforce_ioctl=FAIL ;; esac
    ioctl_return=${enforce_ioctl_line##* = }
    ioctl_result=${ioctl_return%% *}
    ioctl_errno=NOT_OBSERVED
    if [ "$ioctl_result" = -1 ]; then ioctl_errno=$(printf '%s\n' "$ioctl_return" | awk '{print $2}'); fi
    if [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; then
    ioctl_raw_hex=$(printf '%s' "$enforce_ioctl_line" | od -An -tx1 | tr -d ' \n')
      printf 'AZAZEL_C5_ENFORCE_SYSCALL stage=%s target=%s command_return=%s status=%s trace_path=%s raw_hex=%s raw=%s\n' \
        "$( [ "$origin" = initramfs ] && printf initramfs || printf hotplug )" \
        "$device" "$enforce_command_return" "$enforce_ioctl" "$enforce_trace" \
        "$ioctl_raw_hex" "$enforce_ioctl_line" >/dev/console 2>/dev/null || true
      emit_event enforce_ioctl "$enforce_ioctl" \
        "syscall=ioctl result=$ioctl_result errno=$ioctl_errno command_return=$enforce_command_return trace_path=$enforce_trace raw_hex=$ioctl_raw_hex sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev mount_state=$post_mount mount_type=$mount_type mount_flags=$mount_flags"
    fi
  fi
fi
if [ "$enforce_ioctl" = NOT_OBSERVED ] && \
   { [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; }; then
  emit_event enforce_ioctl NOT_OBSERVED \
    "command_return=$enforce_command_return trace_path=$enforce_trace raw_hex=NOT_OBSERVED sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev mount_state=$post_mount"
fi

mechanism_supported=FAIL
if [ "$enforce_ioctl" = PASS ] && [ "$enforce_command_return" = 0 ] && \
   [ "$post_sysfs" = 1 ] && [ "$post_blockdev" = 1 ]; then
  mechanism_supported=PASS
fi
if [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; then
  emit_event post_ro "$mechanism_supported" \
    "sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev mount_state=$post_mount"
  emit_event helper "$mechanism_supported" \
    "sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev mechanism_supported=$mechanism_supported"
  emit_event ro_state "$mechanism_supported" \
    "sysfs_ro_before=$pre_sysfs blockdev_ro_before=$pre_blockdev sysfs_ro_after=$post_sysfs blockdev_ro_after=$post_blockdev"
fi

[ "$post_blockdev" = 1 ] && [ "$post_sysfs" = 1 ] || {
  echo "read-only state was not established for $name" >&2
  if [ "$is_hotplug_fixture" = 1 ]; then
    emit_event quarantine FAIL "mechanism_supported=$mechanism_supported sysfs_ro=$post_sysfs blockdev_ro=$post_blockdev"
  fi
  exit 1
}
[ "$mechanism_supported" = PASS ] && [ "$enforce_status" = PASS ] || {
  echo "read-only state lacks observed enforcement evidence for $name" >&2
  if [ "$is_hotplug_fixture" = 1 ] || [ "$is_initramfs_fixture" = 1 ]; then
    emit_event quarantine FAIL \
      "mechanism_supported=$mechanism_supported enforce_status=$enforce_status sysfs_ro=$post_sysfs blockdev_ro=$post_blockdev"
  fi
  exit 1
}

if [ "$is_hotplug_fixture" = 1 ]; then
  emit_event quarantine "$mechanism_supported" \
    "sysfs_ro=$(sysfs_ro) blockdev_ro=$(blockdev_ro) mechanism_supported=$mechanism_supported probe_executor=systemd-unit"
  handoff_tmp="/run/azazel/c5-hotplug-vdb-$event_seqnum.ready.tmp"
  printf '%s|%s|%s|%s|%s|%s\n' "$event_seqnum" "$device_devno" "$devpath" "$action" "$subsystem" \
    "$(fixture_disk_serial "$sys_device/serial" /sys/devices 2>/dev/null || printf NOT_OBSERVED)" > "$handoff_tmp"
  chmod 0600 "$handoff_tmp"
  mv -f "$handoff_tmp" "/run/azazel/c5-hotplug-vdb-$event_seqnum.ready"
fi
