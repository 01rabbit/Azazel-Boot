#!/bin/sh -e

PREREQS=""
prereqs() { echo "$PREREQS"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

udevadm settle --timeout=60
udevadm control --exit
mount -n -o move /dev "${rootmnt:?}/dev" || mount -n --move /dev "${rootmnt}/dev"
if command -v nuke >/dev/null; then
  nuke /dev
else
  rm -rf /dev
fi
ln -s "${rootmnt}/dev" /dev
