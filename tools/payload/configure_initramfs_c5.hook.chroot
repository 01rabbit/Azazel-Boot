#!/bin/sh
set -eu

base=/usr/share/initramfs-tools
stage_hooks=$base/scripts/init-top
initramfs_init=$base/init
evidence=/var/lib/azazel-c5
mkdir -p "$evidence"

# Debian 13's pinned systemd udev rules request two pseudo-filesystem mounts
# when the fuse/configfs modules load. C5's Boot image policy intentionally
# refuses all udev-triggered mount activation, so remove only these exact lines
# from the exact observed Debian rules file before update-initramfs runs.
python3 - /usr/lib/udev/rules.d/99-systemd.rules "$evidence/udev-pseudo-mount-curation.json" <<'PY'
from pathlib import Path
import hashlib
import json
import sys

rules_path = Path(sys.argv[1])
record_path = Path(sys.argv[2])
expected_source_sha256 = "d63ba2ea309aadf7794a5f84b0f394c2e48fe630640aa37e9963cd9d1b769d89"
expected_lines = [
    'SUBSYSTEM=="module", KERNEL=="fuse", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sys-fs-fuse-connections.mount"',
    'SUBSYSTEM=="module", KERNEL=="configfs", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sys-kernel-config.mount"',
]
if rules_path.is_symlink() or not rules_path.is_file():
    raise SystemExit(f"expected regular Debian systemd udev rules file: {rules_path}")
source = rules_path.read_bytes()
source_sha256 = hashlib.sha256(source).hexdigest()
if source_sha256 != expected_source_sha256:
    raise SystemExit(f"Debian systemd udev rules changed: {source_sha256}")
lines = source.decode("utf-8").splitlines(keepends=True)
removed = []
for expected in expected_lines:
    matches = [index for index, line in enumerate(lines) if line.rstrip("\r\n") == expected]
    if len(matches) != 1:
        raise SystemExit(f"expected exactly one pinned pseudo-mount rule: {expected}")
    index = matches[0]
    removed.append({"line": expected, "sha256": hashlib.sha256(expected.encode()).hexdigest()})
    del lines[index]
curated = "".join(lines).encode("utf-8")
rules_path.write_bytes(curated)
record_path.write_text(json.dumps({
    "schema": "azazel-payload/c5-udev-pseudo-mount-curation@1",
    "source_path": "/usr/lib/udev/rules.d/99-systemd.rules",
    "source_sha256": source_sha256,
    "removed_lines": removed,
    "curated_file_sha256": hashlib.sha256(curated).hexdigest(),
}, indent=2, sort_keys=True) + "\n")
PY

verify_and_remove() {
  name=$1
  expected=$2
  path=$stage_hooks/$name
  [ -f "$path" ] || { echo "expected pinned Debian init-top hook is missing: $name" >&2; exit 1; }
  actual=$(sha256sum "$path" | cut -d ' ' -f 1)
  [ "$actual" = "$expected" ] || {
    echo "Debian initramfs hook changed: $name ($actual != $expected)" >&2
    exit 1
  }
  printf '%s %s\n' "$name" "$actual" >> "$evidence/removed-init-top-hooks.sha256"
  rm -- "$path"
}

: > "$evidence/removed-init-top-hooks.sha256"
verify_and_remove all_generic_ide 59697cff80663c30132578d3fc6128692ff15826b4e32df3468e85db03ba3b93
verify_and_remove blacklist e3fd2f67b92756f053ee3045c45f4d40ba957bf310f2ca64c11f80f6f25604a1
verify_and_remove keymap 2d04d7d7705d1c06cb9fff4c5290c02e719120e43ac65c387f00d8ef37b2d4cf
verify_and_remove udev 5893d2c4c9426b2d6166586cb5bd1852be8fa22ba2984b9e1b2ca15f8b9cca5f

init_bottom_udev=$base/scripts/init-bottom/udev
[ -f "$init_bottom_udev" ] || {
  echo "expected pinned Debian init-bottom hook is missing: udev" >&2
  exit 1
}
init_bottom_udev_hash=$(sha256sum "$init_bottom_udev" | cut -d ' ' -f 1)
[ "$init_bottom_udev_hash" = 5a7595d79328000420c9f641362af1ef15aa5b1bf6ce0114588b49e13f7949a6 ] || {
  echo "Debian initramfs init-bottom hook changed: udev ($init_bottom_udev_hash)" >&2
  exit 1
}
printf 'udev %s\n' "$init_bottom_udev_hash" > "$evidence/removed-init-bottom-hooks.sha256"
rm -- "$init_bottom_udev"

resume_hook=$base/scripts/local-premount/resume
if [ -f "$resume_hook" ]; then
  resume_hash=$(sha256sum "$resume_hook" | cut -d ' ' -f 1)
  case "$resume_hash" in
    e8b4ec9ba6e78965e9c054cd296291b3ed1441b3eef25c9c94b8a37afee53b3a) : ;;
    *) echo "unrecognized initramfs resume hook; refusing to remove it: $resume_hash" >&2; exit 1 ;;
  esac
  printf 'resume %s\n' "$resume_hash" > "$evidence/removed-local-premount-hook.sha256"
  rm -- "$resume_hook"
else
  echo "expected initramfs resume hook is missing" >&2
  exit 1
fi

init_source_hash=$(sha256sum "$initramfs_init" | cut -d ' ' -f 1)
[ "$init_source_hash" = 0a9bb34973c78987922b57f010e99c36ddf102e8a5a2fd198385566539f5d6d5 ] || {
  echo "initramfs /init template does not match pinned Debian 13 source: $init_source_hash" >&2
  exit 1
}
cp "$initramfs_init" "$evidence/init.source"
python3 - "$initramfs_init" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
anchor = "maybe_break top\n"
marker = "# AZAZEL_C5_FIRST_STORAGE_ACTION\n/scripts/azazel-quarantine-first start\n"
if text.count(anchor) != 1 or marker in text:
    raise SystemExit("Debian initramfs /init structure changed or was already patched")
text = text.replace(anchor, marker + anchor, 1)
path.write_text(text)
path.chmod(0o755)
PY

patched_init_hash=$(sha256sum "$initramfs_init" | cut -d ' ' -f 1)
udev_hook=/etc/initramfs-tools/scripts/init-top/50-az-start-udev
handoff_hook=/etc/initramfs-tools/scripts/init-bottom/60-az-handoff-udev
quarantine_rule=/etc/udev/rules.d/00-azazel-quarantine.rules
quarantine_helper=/usr/libexec/azazel-quarantine-block
for required in "$udev_hook" "$handoff_hook" "$quarantine_rule" "$quarantine_helper"; do
  [ -s "$required" ] || { echo "required pinned quarantine input is missing: $required" >&2; exit 1; }
done

cat > "$evidence/configuration.json" <<EOF
{
  "schema": "azazel-payload/c5-initramfs-configuration@1",
  "debian_initramfs_tools_version": "0.148.4",
  "source_init_sha256": "$init_source_hash",
  "source_init_evidence": "init.source",
  "patched_init_sha256": "$patched_init_hash",
  "init_entry_call": "/scripts/azazel-quarantine-first start",
  "removed_init_top_hooks_sha256": "removed-init-top-hooks.sha256",
  "removed_init_bottom_hooks_sha256": "removed-init-bottom-hooks.sha256",
  "removed_local_premount_hook_sha256": "removed-local-premount-hook.sha256",
  "pinned_udev_start_hook_sha256": "$(sha256sum "$udev_hook" | cut -d ' ' -f 1)",
  "pinned_udev_handoff_hook_sha256": "$(sha256sum "$handoff_hook" | cut -d ' ' -f 1)",
  "persistent_udev_rule_sha256": "$(sha256sum "$quarantine_rule" | cut -d ' ' -f 1)",
  "quarantine_helper_sha256": "$(sha256sum "$quarantine_helper" | cut -d ' ' -f 1)"
}
EOF

update-initramfs -u -k all
